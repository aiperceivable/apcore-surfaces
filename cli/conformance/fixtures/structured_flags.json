{
  "description": "Generated object and array options decode JSON before schema validation and execution",
  "schema": {
    "type": "object",
    "properties": {
      "filters": { "type": "object" },
      "labels": { "type": "array", "items": { "type": "string" } },
      "note": { "type": "string" }
    },
    "required": ["filters", "labels"]
  },
  "test_cases": [
    {
      "id": "objects_and_arrays",
      "args": ["--filters", "{\"active\":true,\"limit\":3}", "--labels", "[\"a\",\"b\"]", "--note", "{\"literal\":true}"],
      "expected": { "exit_code": 0, "calls": 1, "input": { "filters": { "active": true, "limit": 3 }, "labels": ["a", "b"], "note": "{\"literal\":true}" } }
    },
    {
      "id": "empty_collections",
      "args": ["--filters", "{}", "--labels", "[]"],
      "expected": { "exit_code": 0, "calls": 1, "input": { "filters": {}, "labels": [] } }
    },
    {
      "id": "malformed_object",
      "args": ["--filters", "{", "--labels", "[]"],
      "expected": { "exit_code": 45, "calls": 0 }
    },
    {
      "id": "wrong_container_type",
      "args": ["--filters", "[]", "--labels", "[]"],
      "expected": { "exit_code": 45, "calls": 0 }
    },
    {
      "id": "wrong_array_items",
      "args": ["--filters", "{}", "--labels", "[17]"],
      "expected": { "exit_code": 45, "calls": 0 }
    }
  ]
}
